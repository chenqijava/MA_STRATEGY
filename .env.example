# 复制为 .env 并填入真实值。.env 已在 .dockerignore/.gitignore 中, 不会被打包或提交。

# ==== OKX 凭证 (必填才能下真单; DRY_RUN=true 时不校验也能启动干跑) ====
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=

# ==== 安全开关 ====
# 默认 true = 只算信号不下单。确认无误后改为 false 才会真实下单。
DRY_RUN=true
# OKX 模拟盘: true = 下单打到 demo trading (不花真钱), 需用 OKX 模拟盘专用 key。
# 用于测试真实下单链路。仅当 DRY_RUN=false 时生效。
OKX_DEMO=false

# ==== 连接 ====
# 直连留空; 走宿主机代理示例(端口按你本地改):
# PROXY=socks5h://host.docker.internal:10808
PROXY=

# ==== 交易/策略参数 (留空则用镜像内已验证默认值) ====
# LEVERAGE=3
# MAX_NOTIONAL_PCT=0.2
# ---- 组合总仓位控制 (双重上限) ----
# MAX_POSITIONS=5              # 同时最多持仓币数
# MAX_TOTAL_NOTIONAL_PCT=1.0  # 总名义敞口上限(占 权益×杠杆 的比例)
# SYMBOLS=BTC,ETH,SOL,BNB,XRP,DOGE,ADA,AVAX,LINK,LTC,DOT,TRX,ATOM,UNI,FIL,APT
# TOUCH_MODE=atr
# TOUCH_ATR=0.5
# ATR_TP=4.0
# ATR_SL=2.0
# CROSS_DELAY=6
# POLL_SECONDS=60
